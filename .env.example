# decor-pos self-hosting — copy to `.env` and replace every value.
# Never commit a real `.env` (it is gitignored).

# --- identity (generate fresh UUIDv7s; these are examples only) ---
STORE_ID=01900000-0000-7000-8000-000000000001
ORG_ID=01900000-0000-7000-8000-000000000002
STORE_NAME=Decor POS Store
CURRENCY=USD

# --- PostgreSQL (provisioned for future HQ mode; unused in v1.0) ---
POSTGRES_USER=decor
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=decorpos

# --- payments (optional; leave empty for the mock terminal) ---
# Live Stripe Terminal calls are not implemented in v1.0; these are
# read env-only by df-payments and never logged or stored.
STRIPE_API_KEY=
STRIPE_TERMINAL_LOCATION_ID=

# --- reports (optional) ---
# Path to a typst binary for monthly-statement PDFs. The Docker image
# does not bundle typst; mount one or run `statements` on the host.
DF_TYPST_BIN=
